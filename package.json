{
  "name": "@kagan-sh/opensearch",
  "version": "0.4.0",
  "description": "OpenCode plugin that combines session, web, and code search",
  "license": "MIT",
  "homepage": "https://kagan-sh.github.io/opensearch/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kagan-sh/opensearch.git"
  },
  "bugs": {
    "url": "https://github.com/kagan-sh/opensearch/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opensearch-mcp": "./dist/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "default": "./dist/mcp.js"
    }
  },
  "files": [
    "dist",
    "plugin",
    "README.md",
    "CONTRIBUTING.md",
    "SKILL.md",
    "LICENSE"
  ],
  "scripts": {
    "mcp": "bun run src/mcp.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:build": "mkdocs build --strict",
    "docs:serve": "mkdocs serve",
    "check": "npm run typecheck && npm run test && npm run build",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@opencode-ai/plugin": "1.2.27",
    "@opencode-ai/sdk": "1.2.27",
    "@opencode/plugin": "2.0.18",
    "@opencode/client": "2.0.18",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "conventional-changelog-conventionalcommits": "9.3.0",
    "semantic-release": "25.0.3",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "peerDependencies": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  }
}
